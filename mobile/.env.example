# Public env vars exposed via expo-constants (prefix EXPO_PUBLIC_)
# Copy to mobile/.env and fill real values for local dev.

# Supabase project (same as web)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Zaltyko web API base. Sin barra final; toda llamada móvil añade /api/*.
EXPO_PUBLIC_API_BASE_URL=https://zaltyko.com

# El projectId de EAS NO es una EXPO_PUBLIC_* ni se copia aquí. `eas init`
# escribe el UUID canónico en app.json -> expo.extra.eas.projectId.
