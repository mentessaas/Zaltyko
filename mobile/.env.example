# Public env vars exposed via expo-constants (prefix EXPO_PUBLIC_)
# Copy to mobile/.env and fill real values for local dev.

# Supabase project (same as web)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Zaltyko web API base
EXPO_PUBLIC_API_BASE_URL=https://app.zaltyko.com

# EAS project id (assigned by `eas init` — also written to app.json extras)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Expo push: en el MVP no se necesita clave de servidor (Expo Push es gratis y
# el sender corre en el backend Next.js). Dejar vacío.
EXPO_PUBLIC_EXPO_PUSH_TOKEN=