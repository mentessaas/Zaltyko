{
  "name": "zaltyko-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild --clean",
    "build:dev": "npx eas-cli@21.4.0 build --profile development --platform all",
    "build:preview": "npx eas-cli@21.4.0 build --profile preview --platform all",
    "build:prod": "npx eas-cli@21.4.0 build --profile production --platform all",
    "submit:ios": "npx eas-cli@21.4.0 submit --platform ios --latest",
    "submit:android": "npx eas-cli@21.4.0 submit --platform android --latest",
    "update:publish": "npx eas-cli@21.4.0 update --branch production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.0",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~57.0.9",
    "expo-application": "~57.0.0",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.0",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.0",
    "expo-local-authentication": "~57.0.0",
    "expo-notifications": "~57.0.8",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "prettier": "^3.4.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
