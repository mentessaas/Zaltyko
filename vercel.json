{
  "git": {
    "deploymentEnabled": false
  },
  "framework": "nextjs",
  "regions": [
    "arn1"
  ],
  "crons": [],
  "env": {
    "NODE_ENV": "production",
    "NODE_OPTIONS": "--max-old-space-size=6144",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 300
    }
  }
}
