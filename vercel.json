{
  "git": {
    "deploymentEnabled": false
  },
  "framework": "nextjs",
  "regions": [
    "arn1"
  ],
  "crons": [
    {
      "path": "/api/cron/usage-at-risk",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/owner-weekly-digest",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/owner-weekly-digest",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/cron/family-payment-reminders",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/family-notices",
      "schedule": "0 17 * * *"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "NODE_OPTIONS": "--max-old-space-size=6144",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  },
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 300
    }
  }
}
